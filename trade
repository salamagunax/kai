-- =============================================
-- In-Game Friend Teleport (ใช้ Remote ของเกมโดยตรง)
-- =============================================
local isHopping = false
local function HopToFriend(targetUsername)
    if isHopping then return end
    isHopping = true

    -- แปลงชื่อเป้าหมายเป็น UserId (เช่น 5000587337)
    local successId, targetUserId = pcall(function()
        return Players:GetUserIdFromNameAsync(targetUsername)
    end)
    
    if successId and targetUserId then
        -- ยิง FireServer ไปที่ teleportToFriend โดยตรง
        pcall(function()
            TeleportToFriendEvent:FireServer(targetUserId)
        end)
        return true
    end

    isHopping = false
    return false
end

