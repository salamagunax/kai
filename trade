local function IsEquipped(itemData)
    if type(itemData) ~= "table" then return false end
    local equipped = itemData.equipped
    if equipped == nil or equipped == false then return false end

    if type(equipped) == "table" then
        local skillSlots = { "e", "q2", "e2", "q" }
        for _, slot in ipairs(skillSlots) do
            if equipped[slot] == true then return true end
        end
        for _, value in pairs(equipped) do
            if value == true then return true end
        end
        return false
    end

    return equipped == true
end

