local function IsEquipped(itemData)
    if type(itemData) ~= "table" then return false end
    local equipped = itemData.equipped
    if equipped == nil or equipped == false then return false end

    if type(equipped) == "table" then
        local skillSlots = { "e", "q2", "e2", "q" }
        for _, slot in ipairs(skillSlots) do
            if equipped[slot] == true then return true end
        end
        for _, value in pairs(equipped) do
            if value == true then return true end
        end
        return false
    end

    return equipped == true
end

local function TriggerAccept()
    local ok = pcall(function()
        if not AcceptRemote then return end
        if AcceptRemote:IsA("RemoteEvent") then
            AcceptRemote:FireServer()
        elseif AcceptRemote:IsA("RemoteFunction") then
            AcceptRemote:InvokeServer()
        end
    end)
    return ok
end

local function ParseItemID(itemKey)
    local strKey = tostring(itemKey)
    local num = string.match(strKey, "%d+")
    return tonumber(num)
end

local function IsTradeInterfaceOpen()
    local tradeGui = LocalPlayer.PlayerGui:FindFirstChild("tradingGui")
    if tradeGui and tradeGui:IsA("ScreenGui") and tradeGui.Enabled then
        return true
    end
    return false
end

-- อ้างอิงปุ่มจริงของหน้าต่างเทรด

local function GetTradeButtons()
    local acceptButton, cancelButton
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local tradeGui = playerGui and playerGui:FindFirstChild("tradingGui")
        local mainBackground = tradeGui and tradeGui:FindFirstChild("mainBackground")
        local innerBackground = mainBackground and mainBackground:FindFirstChild("innerBackground")
        local yourTradeFrame = innerBackground and innerBackground:FindFirstChild("yourTradeFrame")
        if yourTradeFrame then
            acceptButton = yourTradeFrame:FindFirstChild("acceptButton")
            cancelButton = yourTradeFrame:FindFirstChild("cancelButton")
        end
    end)
    return acceptButton, cancelButton
end

local function IsUsableButton(button)
    if not button or not button:IsA("GuiButton") then return false end
    if not button.Visible then return false end
    if button.AbsoluteSize.X <= 1 or button.AbsoluteSize.Y <= 1 then return false end
    return true
end

-- กด Accept ซ้ำจนกว่าปุ่มของเราจะเปลี่ยนเป็น Cancel
local function MakeSureAccepted()
    local startTime = os.clock()
    local maxWait = 30
    local attempts = 0

    while AutoLoopActive and IsTradeInterfaceOpen() and (os.clock() - startTime) < maxWait do
        local acceptButton, cancelButton = GetTradeButtons()

        if IsUsableButton(cancelButton) then
            StatusLabel.Text = string.format("✅ เรา Accepted แล้ว (Cancel) | กด %d ครั้ง", attempts)
            return true
        end

        if IsUsableButton(acceptButton) then
            attempts = attempts + 1
            TriggerAccept()
            StatusLabel.Text = string.format("🔄 ปุ่มยังเป็น Accept -> กดใหม่ (%d)", attempts)
        else
            StatusLabel.Text = "⏳ รอปุ่ม Accept/Cancel อัปเดต..."
        end

        task.wait(0.35)
    end

    local _, cancelButton = GetTradeButtons()
    if IsUsableButton(cancelButton) then
        StatusLabel.Text = "✅ เรา Accepted แล้ว (Cancel)"
        return true
    end

    if IsTradeInterfaceOpen() then
        StatusLabel.Text = "⚠️ ยังไม่ขึ้น Cancel - จะไม่เริ่มรอบใหม่จนกว่าจะพร้อม"
    end
    return false
end

-- รอจน tradingGui ปิดจริง หลังจากทั้งสองฝ่าย Accepted
local function WaitUntilTradeFinished()
    local elapsed = 0

    while AutoLoopActive and IsTradeInterfaceOpen() do
        local acceptButton, cancelButton = GetTradeButtons()

        if IsUsableButton(acceptButton) and not IsUsableButton(cancelButton) then
            TriggerAccept()
            StatusLabel.Text = "🔄 Accept หลุดระหว่างรอ -> กดกลับเป็น Cancel..."
        elseif IsUsableButton(cancelButton) then
            if elapsed < 5 then
                StatusLabel.Text = string.format("⏳ ทั้งคู่พร้อมแล้ว รอเทรดสำเร็จ... %.1fs", 5 - elapsed)
            else
                StatusLabel.Text = "⏳ รอหน้าต่างเทรดปิด..."
            end
        else
            StatusLabel.Text = "⏳ รอสถานะเทรดอัปเดต..."
        end

        task.wait(0.25)
        elapsed = elapsed + 0.25
    end

    return not IsTradeInterfaceOpen()
end

local function GetInventoryCount()
    local success, myInventory = pcall(function()
        return invModule.GetPlayerInvy()
    end)
    if not success or not myInventory then return 0, 300 end

    local totalCount = 0
    for catKey, catData in pairs(myInventory) do
        if type(catData) == "table" then
            for _, _ in pairs(catData) do
                totalCount = totalCount + 1
            end
        end
    end
    return totalCount, 300
end

local function AutoClearSpaceTo299()
    local currentCount, maxCount = GetInventoryCount()
    
    while currentCount >= 300 and AutoLoopActive do
        StatusLabel.Text = string.format("⚠️ เป๋าเกิน (%d/%d) กำลังเคลียร์ขายออกให้เหลือ 299...", currentCount, maxCount)
        local myInventory = invModule.GetPlayerInvy()
        local soldOne = false
        
        for catKey, catData in pairs(myInventory) do
            if type(catData) == "table" then
                for itemKey, itemData in pairs(catData) do
                    if not IsEquipped(itemData) then
                        local itemID = ParseItemID(itemKey)
                        if itemID then
                            local rarity = itemData.rarity or itemData.Rarity or "common"
                            local curRarity = tostring(rarity):lower()
                            
                            if not SelectedRarities[curRarity] or curRarity == "common" or curRarity == "uncommon" then
                                local remoteCat = CategoryMap[catKey] or catKey
                                local sellArgs = {
                                    {
                                        helmet = remoteCat == "helmet" and {itemID} or {},
                                        ability = remoteCat == "ability" and {itemID} or {},
                                        chest = remoteCat == "chest" and {itemID} or {},
                                        weapon = remoteCat == "weapon" and {itemID} or {}
                                    }
                                }
                                
                                StatusLabel.Text = string.format("🗑️ Log ขายทิ้ง ID: %s (%s)", tostring(itemID), remoteCat)
                                pcall(function()
                                    SellItemEvent:FireServer(unpack(sellArgs))
                                end)
                                
                                task.wait(0.4)
                                soldOne = true
                                break
                            end
                        end
                    end
                end
            end
            if soldOne then break end
        end
        
        currentCount, maxCount = GetInventoryCount()
        task.wait(0.2)
        if not soldOne then break end
    end
end

local function ProcessSingleTrade()
    if not IsTradeInterfaceOpen() then return false end

    local myInventory = invModule.GetPlayerInvy()
    local itemsAddedCount = 0
    local MaxItemsLimit = 30
    
    local cur, max = GetInventoryCount()
    StatusLabel.Text = string.format("⏳ กำลังใส่ไอเทม (เป๋า: %d/%d)...", cur, max)

    for catKey, isSelected in pairs(SelectedCategories) do
        if isSelected and myInventory[catKey] then
            local remoteCat = CategoryMap[catKey] or catKey
            for itemKey, itemData in pairs(myInventory[catKey]) do
                if itemsAddedCount >= MaxItemsLimit then break end
                if not IsTradeInterfaceOpen() then return false end

                if not IsEquipped(itemData) then
                    local itemID = ParseItemID(itemKey)
                    local pass = false
                    
                    if catKey == "abilities" then
                        pass = true
                    else
                        local rarity = itemData.rarity or itemData.Rarity or "common"
                        local curRarity = tostring(rarity):lower()
                        if SelectedRarities[curRarity] then pass = true end
                    end

                    if pass and itemID then
                        pcall(function() AddItemEvent:FireServer(remoteCat, itemID) end)
                        itemsAddedCount = itemsAddedCount + 1
                        StatusLabel.Text = string.format("📊 ใส่ไอเทมแล้ว: %d ชิ้น (เป๋า: %d/%d)", itemsAddedCount, GetInventoryCount())
                        task.wait(0.1)
                    end
                end
            end
        end
        if itemsAddedCount >= MaxItemsLimit then break end
    end

    if itemsAddedCount > 0 then
        StatusLabel.Text = "✅ ใส่ของครบแล้ว กำลังตรวจปุ่ม Accept..."
        task.wait(0.6)

        local accepted = MakeSureAccepted()
        if not accepted then
            -- อย่าส่ง Trade Request ใหม่ทับหน้าต่างเดิม
            -- รอให้หน้าต่างเดิมปิดก่อน แล้วค่อยให้ Auto Loop เริ่มรอบใหม่
            while AutoLoopActive and IsTradeInterfaceOpen() do
                task.wait(0.5)
            end
            return false
        end

        -- ยังไม่ถือว่าเสร็จจนกว่าหน้าต่างเทรดจะหายจริง
        local finished = WaitUntilTradeFinished()
        if finished then
            StatusLabel.Text = "✅ เทรดเสร็จสิ้น - หน้าต่างหายแล้ว"
        end
    else
        StatusLabel.Text = "⚠️ ไม่พบไอเทมที่ตรงเงื่อนไขความแรร์ในรอบนี้"
    end

    return true
end

