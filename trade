-- Trade Helpers
-- =============================================
local function GetTradeGui()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    return playerGui and playerGui:FindFirstChild("tradingGui")
end

local function GetTradeFrame()
    local tradeGui = GetTradeGui()
    if not tradeGui then return nil end
    local main = tradeGui:FindFirstChild("mainBackground")
    local inner = main and main:FindFirstChild("innerBackground")
    return inner and inner:FindFirstChild("yourTradeFrame")
end

local function GetTradeButtons()
    local frame = GetTradeFrame()
    if not frame then return nil, nil end
    return frame:FindFirstChild("acceptButton"), frame:FindFirstChild("cancelButton")
end

local function IsTradeInterfaceOpen()
    local tradeGui = GetTradeGui()
    if not tradeGui then return false end
    if tradeGui:IsA("ScreenGui") then
        return tradeGui.Enabled == true
    end
    return true
end

local function IsOurTradeAccepted()
    local acceptButton, cancelButton = GetTradeButtons()
    if cancelButton and cancelButton:IsA("GuiObject") and cancelButton.Visible then
        return true
    end
    if acceptButton and acceptButton:IsA("GuiObject") and not acceptButton.Visible then
        return true
    end
    return false
end

local function TriggerAccept()
    pcall(function()
        if AcceptRemote:IsA("RemoteEvent") then
            AcceptRemote:FireServer()
        elseif AcceptRemote:IsA("RemoteFunction") then
            AcceptRemote:InvokeServer()
        end
    end)
end

local function EnsureOurTradeAccepted(maxAttempts)
    maxAttempts = maxAttempts or 3

    for attempt = 1, maxAttempts do
        if not AutoLoopActive or not IsTradeInterfaceOpen() then return false end

        if IsOurTradeAccepted() then
            StatusLabel.Text = "✅ ขึ้น Cancel แล้ว — เราพร้อมเทรด"
            return true
        end

        StatusLabel.Text = string.format("🔄 ยิง playerAcceptTrade (รอบที่ %d/%d)...", attempt, maxAttempts)
        TriggerAccept()

        local waitStart = os.clock()
        while AutoLoopActive and IsTradeInterfaceOpen() and (os.clock() - waitStart) < 5 do
            if IsOurTradeAccepted() then
                StatusLabel.Text = "✅ ขึ้น Cancel แล้ว — เราพร้อมเทรด"
                return true
            end
            task.wait(0.2)
        end
    end

    return IsOurTradeAccepted()
end

local function WaitUntilTradeFinished()
    while AutoLoopActive and IsTradeInterfaceOpen() do
        local ourAccepted = IsOurTradeAccepted()

        if not ourAccepted then
            StatusLabel.Text = "🔄 ปุ่มยังเป็น Accept — กำลังกด Accept ใหม่และรอ 5 วิ..."
            TriggerAccept()
            
            local waitStart = os.clock()
            while AutoLoopActive and IsTradeInterfaceOpen() and (os.clock() - waitStart) < 5 do
                if IsOurTradeAccepted() then break end
                task.wait(0.2)
            end
        else
            StatusLabel.Text = "⏳ เรา Accepted แล้ว (Cancel) — รอ Trade สำเร็จ..."
            task.wait(0.5)
        end
    end

    if not IsTradeInterfaceOpen() then
        StatusLabel.Text = "🎉 เทรดเสร็จสิ้น — หน้าต่างเทรดปิดแล้ว"
        return true
    end

    return false
end

local function ParseItemID(itemKey)
    local strKey = tostring(itemKey)
    local num = string.match(strKey, "%d+")
    return tonumber(num)
end

local function GetInventoryCount()
    local success, myInventory = pcall(function()
        return invModule.GetPlayerInvy()
    end)
    if not success or not myInventory then return 0, 300 end

    local totalCount = 0
    for catKey, catData in pairs(myInventory) do
        if type(catData) == "table" then
            for _, _ in pairs(catData) do
                totalCount = totalCount + 1
            end
        end
    end
    return totalCount, 300
end

local function AutoClearSpaceTo299()
    local currentCount, maxCount = GetInventoryCount()
    
    while currentCount >= 300 and AutoLoopActive do
        StatusLabel.Text = string.format("⚠️ เป๋าเกิน (%d/%d) กำลังเคลียร์ขายออกให้เหลือ 299...", currentCount, maxCount)
        local myInventory = invModule.GetPlayerInvy()
        local soldOne = false
        
        for catKey, catData in pairs(myInventory) do
            if type(catData) == "table" then
                for itemKey, itemData in pairs(catData) do
                    if not IsEquipped(itemData) then
                        local itemID = ParseItemID(itemKey)
                        if itemID then
                            local rarity = itemData.rarity or itemData.Rarity or "common"
                            local curRarity = tostring(rarity):lower()
                            
                            if not SelectedRarities[curRarity] or curRarity == "common" or curRarity == "uncommon" then
                                local remoteCat = CategoryMap[catKey] or catKey
                                local sellArgs = {
                                    {
                                        helmet = remoteCat == "helmet" and {itemID} or {},
                                        ability = remoteCat == "ability" and {itemID} or {},
                                        chest = remoteCat == "chest" and {itemID} or {},
                                        weapon = remoteCat == "weapon" and {itemID} or {}
                                    }
                                }
                                
                                StatusLabel.Text = string.format("🗑️ Log ขายทิ้ง ID: %s (%s)", tostring(itemID), remoteCat)
                                pcall(function()
                                    SellItemEvent:FireServer(unpack(sellArgs))
                                end)
                                
                                task.wait(0.4)
                                soldOne = true
                                break
                            end
                        end
                    end
                end
            end
            if soldOne then break end
        end
        
        currentCount, maxCount = GetInventoryCount()
        task.wait(0.2)
        if not soldOne then break end
    end
end

local function ProcessSingleTrade()
    if not IsTradeInterfaceOpen() then return false end

    local myInventory = invModule.GetPlayerInvy()
    local itemsAddedCount = 0
    local MaxItemsLimit = 30

    local cur, max = GetInventoryCount()
    StatusLabel.Text = string.format("⏳ กำลังใส่ไอเทม (เป๋า: %d/%d)...", cur, max)

    for catKey, isSelected in pairs(SelectedCategories) do
        if isSelected and myInventory[catKey] then
            local remoteCat = CategoryMap[catKey] or catKey

            for itemKey, itemData in pairs(myInventory[catKey]) do
                if itemsAddedCount >= MaxItemsLimit then break end
                if not IsTradeInterfaceOpen() then return false end

                if not IsEquipped(itemData) then
                    local itemID = ParseItemID(itemKey)
                    local pass = false

                    if catKey == "abilities" then
                        pass = true
                    else
                        local rarity = itemData.rarity or itemData.Rarity or "common"
                        local curRarity = tostring(rarity):lower()
                        if SelectedRarities[curRarity] then
                            pass = true
                        end
                    end

                    if pass and itemID then
                        pcall(function()
                            AddItemEvent:FireServer(remoteCat, itemID)
                        end)

                        itemsAddedCount = itemsAddedCount + 1
                        StatusLabel.Text = string.format(
                            "📊 ใส่ไอเทมแล้ว: %d ชิ้น (เป๋า: %d/%d)",
                            itemsAddedCount,
                            GetInventoryCount()
                        )

                        task.wait(0.1)
                    end
                end
            end
        end

        if itemsAddedCount >= MaxItemsLimit then break end
    end

    if itemsAddedCount > 0 then
        StatusLabel.Text = "📦 ใส่ของครบแล้ว — กำลังกด Accept ของเรา..."
        task.wait(0.5)
        EnsureOurTradeAccepted(3)

        if AutoLoopActive and IsTradeInterfaceOpen() then
            WaitUntilTradeFinished()
        end
    else
        StatusLabel.Text = "⚠️ ไม่พบไอเทมที่ตรงเงื่อนไขความแรร์ในรอบนี้"
    end

    return IsTradeInterfaceOpen() == false
end

