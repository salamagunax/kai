local function ToggleAutoLoop(state)
    AutoLoopActive = state
    AutoLoopSavedState = state
    SaveConfig()
    
    if AutoLoopActive then
        AutoLoopBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
        AutoLoopBtn.Text = "⏹ หยุดระบบ Safe Auto Loop (On)"
        
        task.spawn(function()
            while AutoLoopActive do
                AutoClearSpaceTo299()

                local targetPlayer = nil
                if SavedTargetName ~= "" then
                    targetPlayer = Players:FindFirstChild(SavedTargetName)
                end
                
                if not targetPlayer and SelectedTargetPlayer and SelectedTargetPlayer.Parent == Players then
                    targetPlayer = SelectedTargetPlayer
                end

                if targetPlayer then
                    SelectedTargetPlayer = targetPlayer
                    PlayerBtn.Text = "🎯 เป้าหมาย: " .. targetPlayer.Name
                    
                    local cur, max = GetInventoryCount()
                    StatusLabel.Text = string.format("📤 ส่งคำขอหา: %s [เป๋า: %d/%d]", targetPlayer.Name, cur, max)
                    
                    pcall(function()
                        local success = pcall(function() SendTradeReq:InvokeServer(targetPlayer) end)
                        if not success then SendTradeReq:InvokeServer(targetPlayer.Name) end
                    end)
                    
                    local waitTimer = 0
                    local tradeOpened = false
                    while AutoLoopActive and not tradeOpened and waitTimer < 5 do
                        if IsTradeInterfaceOpen() then tradeOpened = true; break end
                        task.wait(0.5)
                        waitTimer = waitTimer + 0.5
                    end

                    if tradeOpened and AutoLoopActive then
                        ProcessSingleTrade()
                    end
                else
                    -- ไม่พบเป้าหมายในเซิร์ฟเวอร์ -> เรียกยิง Remote teleportToFriend
                    if SavedTargetName ~= "" then
                        StatusLabel.Text = string.format("🚀 ยิง teleportToFriend หา %s...", SavedTargetName)
                        PlayerBtn.Text = string.format("🎯 เป้าหมาย: %s (กำลังวาร์ป...)", SavedTargetName)
                        
                        HopToFriend(SavedTargetName)
                    else
                        StatusLabel.Text = "❌ ยังไม่ได้เลือกผู้เล่นเป้าหมาย"
                    end
                end
                task.wait(3)
            end
        end)
    else
        AutoLoopBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 70)
        AutoLoopBtn.Text = "🔄 เริ่มระบบ Safe Auto Loop (Off)"
        StatusLabel.Text = "⏹ หยุดการทำงานเรียบร้อย"
    end
end

