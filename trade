local function SaveConfig()
    if writefile then
        local data = {
            Categories = SelectedCategories,
            Rarities = SelectedRarities,
            AutoLoopState = AutoLoopSavedState,
            TargetName = SavedTargetName
        }
        pcall(function()
            writefile(ConfigFileName, game:GetService("HttpService"):JSONEncode(data))
        end)
    end
end

local function LoadConfig()
    if isfile and isfile(ConfigFileName) and readfile then
        pcall(function()
            local content = readfile(ConfigFileName)
            local data = game:GetService("HttpService"):JSONDecode(content)
            
            if data and type(data) == "table" then
                if data.Categories then SelectedCategories = data.Categories end
                if data.Rarities then SelectedRarities = data.Rarities end
                if data.AutoLoopState ~= nil then AutoLoopSavedState = data.AutoLoopState end
                if data.TargetName then SavedTargetName = data.TargetName end
            end
        end)
    end
end

